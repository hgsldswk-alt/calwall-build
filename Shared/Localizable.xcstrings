    "events.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off. Turn it on in Settings to show events."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有日历权限，可在系统设置里打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有行事曆權限，可在系統設定裡打開"
          }
        }
      }
    },
    "events.on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events ✓ On"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程 ✓ 已显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行程 ✓ 已顯示"
          }
        }
      }
    },
    "events.show": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show my events"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示我的日程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示我的行程"
          }
        }
      }
    },
    "guide.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Shortcuts → Automation → Time of Day, 12:05 AM, Daily."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「快捷指令」→ 自动化 → 特定时间，0:05，每天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開「捷徑」→ 自動化 → 特定時間，0:05，每天。"
          }
        }
      }
    },
    "guide.1b": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose “Run Immediately”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选「立即运行」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選「立即執行」。"
          }
        }
      }
    },
    "guide.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the action “Make Calendar Wallpaper”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加操作「生成日历壁纸」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入動作「產生日曆桌布」。"
          }
        }
      }
    },
    "guide.2b": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It runs in the background. The app does not open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在后台运行，不会打开 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它在背景執行，不會打開 App。"
          }
        }
      }
    },
    "guide.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add “Set Wallpaper” → Lock Screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再添加「设定墙纸」→ 锁定屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再加入「設定背景圖片」→ 鎖定畫面。"
          }
        }
      }
    },
    "guide.3b": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn “Show Preview” off, so nothing pops up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉「显示预览」，就不会弹出画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關掉「顯示預覽」，就不會跳出畫面。"
          }
        }
      }
    },
    "guide.notYet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not run yet. After you set it up, this shows the last update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没运行过。设好之后这里会显示上次更新时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒執行過。設定好之後這裡會顯示上次更新時間。"
          }
        }
      }
    },
    "guide.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Shortcuts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开快捷指令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開捷徑"
          }
        }
      }
    },
    "guide.saveNow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want it now? Save to Photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在就要？存到相册"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在就要？存到相簿"
          }
        }
      }
    },
    "home.zoneHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashed area = clock. Nothing is drawn there. Tap the preview to fine-tune."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚线框是锁屏时钟区，不放内容。点预览可细调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "虛線框是鎖定畫面時鐘區，不放內容。點預覽可微調。"
          }
        }
      }
    },
    "intent.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make Calendar Wallpaper"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成日历壁纸"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生日曆桌布"
          }
        }
      }
    },
    "intent.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draws today's calendar and events onto your wallpaper. Pair it with Set Wallpaper."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把今天的日历和日程画进壁纸，配合「设定墙纸」使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把今天的日曆和行程畫進桌布，搭配「設定背景圖片」使用。"
          }
        }
      }
    },
    "intent.short": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make Wallpaper"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成壁纸"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生桌布"
          }
        }
      }
    },
    "intent.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't make the wallpaper. Open the app once and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "壁纸没生成出来，打开一次 App 再试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌布沒產生出來，打開一次 App 再試"
          }
        }
      }
    },
    "milestone.title": {
