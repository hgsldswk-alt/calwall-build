    "code.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get my lock screen style in Calendar Wallpaper → Settings → Paste code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「日程壁纸」设置里粘贴这段口令，就能用我的锁屏样式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「日程桌布」設定裡貼上這段口令，就能用我的鎖定畫面樣式"
          }
        }
      }
    },
    "code.copied": {
      "localizations": {
